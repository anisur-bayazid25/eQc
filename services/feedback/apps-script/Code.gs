// eQc feedback for Google Apps Script. Paste this entire file into Code.gs.
// Generated from the shared report schema and backend.gs; no passwords or API keys.

// Shared by the desktop bridge and the hosted service. Never accepts project data.
const RECIPIENT = 'anisur.rahman.bayazid@gmail.com';
const MAX_SCREENSHOT_BYTES = 3 * 1024 * 1024;
const DEVICE_FIELDS = ['App version','Operating system','Architecture','Memory','Display','Scale factor','Electron','Chromium'];
function validateFeedback(input) {
  if (!input || typeof input !== 'object' || input.schemaVersion !== 1) throw Error('This report format is not supported.');
  const text = (key, max, required = false) => {
    if (input[key] !== undefined && typeof input[key] !== 'string') throw Error(`Invalid ${key}.`);
    const value = (input[key] || '').trim();
    if ((required && !value) || value.length > max) throw Error(`Please check ${key}.`);
    return value;
  };
  const id = text('id', 36, true);
  if (!/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(id)) throw Error('Invalid report identifier.');
  if (!['bug','feature','other'].includes(input.kind)) throw Error('Choose a report type.');
  const senderName = text('senderName',120,true);
  if (/[\r\n\x00-\x1f\x7f]/.test(senderName)) throw Error('Please enter your name on one line.');
  const replyTo = text('replyTo',254,true), subject = text('subject',160,true);
  if (!/^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(replyTo) || /[\r\n]/.test(subject)) throw Error('Please check your email address and subject.');
  const result = {schemaVersion:1,id,kind:input.kind,senderName,replyTo,subject,description:text('description',12000,true),steps:text('steps',6000),expected:text('expected',4000)};
  if (input.device !== undefined) {
    if (!input.device || typeof input.device !== 'object' || Array.isArray(input.device)) throw Error('Invalid device information.');
    result.device = {};
    for (const key of DEVICE_FIELDS) if (input.device[key] !== undefined) {
      if (typeof input.device[key] !== 'string' || input.device[key].length > 200) throw Error('Invalid device information.');
      result.device[key] = input.device[key];
    }
  }
  if (input.screenshot !== undefined) {
    const base64 = input.screenshot?.base64;
    if (typeof base64 !== 'string' || base64.length > 4 * Math.ceil(MAX_SCREENSHOT_BYTES / 3) || !/^[A-Za-z0-9+/]+={0,2}$/.test(base64) || base64.length % 4 || !base64.startsWith('iVBORw0KGgo')) throw Error('Choose a PNG screenshot no larger than 3 MB.');
    const head = eqcDecodeHead(base64.slice(0,44));
    const integer = offset => Array.from(head.slice(offset,offset+4)).reduce((value,char)=>value*256+char.charCodeAt(0),0);
    const width = integer(16), height = integer(20);
    if (head.slice(12,16) !== 'IHDR' || !width || !height || width > 4096 || height > 4096 || width*height > 8000000) throw Error('Screenshot dimensions are too large or invalid.');
    result.screenshot = {name:'screenshot.png',base64};
  }
  return result;
}
function feedbackText(report) {
  return [
    'eQc feedback', `Report ID: ${report.id}`, `Type: ${report.kind}`, `Sender name: ${report.senderName}`, `Reply to: ${report.replyTo}`, `Subject: ${report.subject}`,
    '', 'Description', report.description,
    ...(report.steps ? ['', 'Steps to reproduce', report.steps] : []),
    ...(report.expected ? ['', 'Expected behaviour', report.expected] : []),
    ...(report.device ? ['', 'Device information', ...Object.entries(report.device).map(([key,value])=>`${key}: ${value}`)] : []),
    '', report.screenshot ? 'Screenshot: screenshot.png (attached)' : 'No screenshot attached.'
  ].join('\n');
}

function eqcDecodeHead(value) { return Utilities.base64Decode(value).map(byte=>String.fromCharCode((byte+256)%256)).join(''); }

// Google-hosted controller. Code.gs is generated by build.cjs with the shared schema.
const EQC_DAILY_LIMIT = 50;
const EQC_MINUTE_LIMIT = 5;
const EQC_SENDER_HOURLY_LIMIT = 3;
const EQC_RETENTION_MS = 48 * 60 * 60 * 1000;
const EQC_MAX_BODY_BYTES = 4300000;

function eqcJson(value) {
  return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);
}
function eqcHash(value) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,value,Utilities.Charset.UTF_8)
    .map(byte=>((byte+256)%256).toString(16).padStart(2,'0')).join('');
}
function eqcStored(properties,key,fallback) {
  const value=properties.getProperty(key);
  return value===null?fallback:JSON.parse(value);
}
function eqcWindow(previous,now,duration) {
  return previous && now-previous.start < duration && now >= previous.start ? previous : {start:now,count:0};
}
function eqcCleanup(properties,now) {
  const records=properties.getProperties();
  Object.keys(records).forEach(key=>{
    if(!key.startsWith('eqc.report.')&&!key.startsWith('eqc.sender.'))return;
    const record=JSON.parse(records[key]);
    if(now-(record.at||record.start||0)>EQC_RETENTION_MS)properties.deleteProperty(key);
  });
}

// Run once from the Apps Script editor to authorize sending. This sends no email.
function authorizeFeedback() {
  const remaining=MailApp.getRemainingDailyQuota();
  console.log('eQc feedback authorized. Remaining recipient quota: '+remaining+'. App cap: '+EQC_DAILY_LIMIT+' reports per rolling 24 hours.');
  return {authorized:true,dailyReportCap:EQC_DAILY_LIMIT,remainingRecipients:remaining};
}
function doGet() {
  return eqcJson({service:'eQc feedback',backend:'google-apps-script',schemaVersion:1,dailyReportCap:EQC_DAILY_LIMIT,requiredFields:['senderName','replyTo']});
}
function doPost(event) {
  let report;
  try {
    const data=event&&event.postData,body=data&&data.contents;
    if(!data||typeof body!=='string'||!String(data.type||'').toLowerCase().startsWith('application/json')||body.length>EQC_MAX_BODY_BYTES||Utilities.newBlob(body).getBytes().length>EQC_MAX_BODY_BYTES)throw Error('Invalid report.');
    report=validateFeedback(JSON.parse(body));
  } catch (_) {return eqcJson({ok:false,code:'invalid_report'});}

  const lock=LockService.getScriptLock();
  if(!lock.tryLock(1000))return eqcJson({ok:false,code:'busy'});
  try {
    const now=Date.now(),properties=PropertiesService.getScriptProperties();
    eqcCleanup(properties,now);
    const reportKey='eqc.report.'+report.id,hash=eqcHash(JSON.stringify(report));
    const prior=eqcStored(properties,reportKey,null);
    if(prior){
      if(prior.hash!==hash)return eqcJson({ok:false,code:'id_conflict'});
      if(prior.state==='sent')return eqcJson({ok:true,reportId:report.id,delivery:'accepted',duplicate:true});
      // An interrupted/failed send may already have reached MailApp. Do not resend.
      return eqcJson({ok:false,code:'delivery_uncertain'});
    }
    const state=eqcStored(properties,'eqc.limits',{});
    const day=eqcWindow(state.day,now,24*60*60*1000),minute=eqcWindow(state.minute,now,60*1000);
    if(day.count>=EQC_DAILY_LIMIT||MailApp.getRemainingDailyQuota()<1)return eqcJson({ok:false,code:'daily_limit'});
    const senderKey='eqc.sender.'+eqcHash(report.replyTo.toLowerCase());
    const sender=eqcWindow(eqcStored(properties,senderKey,null),now,60*60*1000);
    if(minute.count>=EQC_MINUTE_LIMIT||sender.count>=EQC_SENDER_HOURLY_LIMIT)return eqcJson({ok:false,code:'rate_limited'});

    const labels={bug:'Bug report',feature:'Feature request',other:'Feedback'};
    const mail={to:RECIPIENT,replyTo:report.replyTo,name:'eQc feedback',subject:'[eQc '+labels[report.kind]+'] '+report.subject,body:feedbackText(report)};
    if(report.screenshot)mail.attachments=[Utilities.newBlob(Utilities.base64Decode(report.screenshot.base64),'image/png','screenshot.png')];

    // Reserve the quota and ID before sending, under the same lock. A server
    // interruption cannot trigger an automatic second email on retry.
    day.count++;minute.count++;sender.count++;
    const updates={};
    updates['eqc.limits']=JSON.stringify({day:day,minute:minute});
    updates[senderKey]=JSON.stringify(sender);
    updates[reportKey]=JSON.stringify({hash:hash,at:now,state:'sending'});
    properties.setProperties(updates,false);
    try {
      MailApp.sendEmail(mail);
      properties.setProperty(reportKey,JSON.stringify({hash:hash,at:now,state:'sent'}));
    } catch (_) {return eqcJson({ok:false,code:'delivery_uncertain'});}
    return eqcJson({ok:true,reportId:report.id,delivery:'accepted'});
  } catch (_) {return eqcJson({ok:false,code:'service_unavailable'});}
  finally {lock.releaseLock();}
}
